#include <Stepper.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

const int stepsPerRevolution = 200;
const int ThrottlePin = A0;

// Initialise the stepper library on pins 10, 11, 9, 8
Stepper myStepper(stepsPerRevolution, 10, 11, 9, 8);

void setup() {
  lcd.init();
  lcd.backlight();
}

void loop() {
  int sensorValue = analogRead(ThrottlePin);
  
  // Mapping
  int RPM_Value = map(sensorValue, 0, 1023, 0, 200);
  myStepper.setSpeed(RPM_Value);  // Set the speed in RPM

  // LCD
  lcd.setCursor(0, 0);
  lcd.print("Speed: ");
  lcd.print(RPM_Value, 1);
  lcd.print(" RPM");

  myStepper.step(stepsPerRevolution);  // Move one full revolution
  delay(500);  // Wait for a 500ms
  myStepper.step(-stepsPerRevolution);  // Move one full revolution in the other direction
  delay(500);  // Wait for a 500ms
  lcd.clear();

}
