#include <Wire.h> 
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

float input_current = 0.0;

void setup() {
  lcd.init();
  lcd.backlight();
  Serial.begin(9600);
}

void loop() {
   int analog_value = analogRead(A0);
   input_current = (analog_value * 5) / 1024.0; 

   
   if (input_current < 0.1) 
   {
     input_current=0.0;
   } 
  	lcd.setCursor(1, 0);
  	lcd.print("Currentmeter");
    lcd.setCursor(0, 1);
    lcd.print("Current = ");
    lcd.print(input_current);
    delay(500);
}
